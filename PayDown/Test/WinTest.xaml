<Window x:Class="PayDown.WinTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PayDown"
        mc:Ignorable="d"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        skinManager:SfSkinManager.Theme="{skinManager:SkinManagerExtension ThemeName=Material3Light}"
        Title="WinTest" Height="450" Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Visible" x:Name="scrollViewer" PreviewMouseWheel="scrollViewer_PreviewMouseWheel" Focusable="True">
        <Grid Height="900" Background="Blue">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <syncfusion:SfDataGrid
                x:Name="sfdatagrid"
                Margin="0"
                AllowEditing="True"
                GridLinesVisibility="Horizontal"
                AllowGrouping="True"
                AutoGenerateColumns="False"
                ColumnSizer="Star"
                FontSize="18"
                EditTrigger ="OnTap"
                RowHeight="32"
                AllowSorting="False"
                SelectionMode="Single"
                SelectionUnit="Cell">
                <syncfusion:SfDataGrid.Resources>
                    <Style TargetType="syncfusion:GridHeaderCellControl">
                        <Setter Property="Background" Value="DarkGreen"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </syncfusion:SfDataGrid.Resources>
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource1" Width="200">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource1}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                                    TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                                    Text="{Binding MSource1}"
                                    Padding="24,0,12,0"
                                    syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
            <syncfusion:SfDataGrid
                Grid.Row="1"
                Margin="0"
                AllowEditing="True"
                GridLinesVisibility="Horizontal"
                AllowGrouping="True"
                AutoGenerateColumns="False"
                ColumnSizer="Star"
                FontSize="18"
                EditTrigger ="OnTap"
                RowHeight="32"
                AllowSorting="False"
                SelectionMode="Single"
                SelectionUnit="Cell">
                <syncfusion:SfDataGrid.Resources>
                    <Style TargetType="syncfusion:GridHeaderCellControl">
                        <Setter Property="Background" Value="DarkGreen"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </syncfusion:SfDataGrid.Resources>
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource1" Width="200">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource1}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                Text="{Binding MSource1}"
                Padding="24,0,12,0"
                syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

        </Grid>
    </ScrollViewer>
</Window>
