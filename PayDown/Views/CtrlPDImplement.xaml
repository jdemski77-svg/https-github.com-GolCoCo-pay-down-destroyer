<UserControl x:Class="PayDown.Views.CtrlPDImplement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PayDown.Views"
              xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:busy="clr-namespace:Syncfusion.Windows.Controls.Notification;assembly=Syncfusion.SfBusyIndicator.WPF"
             xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             skinManager:SfSkinManager.Theme="{skinManager:SkinManagerExtension ThemeName=Material3Light}"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded" d:DesignWidth="1600" d:DesignHeight="497">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="680"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <syncfusion:SfAccordion
                        x:Name="accordion1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="4,4,4,4"
                        Cursor="Hand"
                        SelectedIndex="1"
                        SelectionMode="One">
                            <syncfusion:SfAccordion.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid Background="DarkMagenta" Opacity="1" Margin="-14,0,-31,-4" Height="42">
                                            <TextBlock Foreground="white" TextWrapping="Wrap" Text="IDENTIFY THE DEBT DESTROYER" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" FontFamily="Arial Black" Margin="0,0,0,0" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </syncfusion:SfAccordion.HeaderTemplate>
                            <syncfusion:SfAccordionItem Header="WPF" FontSize="14" FontWeight="Bold">
                                <Grid HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock 
                                Margin="4,4,4,4"
                                HorizontalAlignment="Left"
                                Foreground="Black"
                                FontSize="14"
                                TextWrapping="Wrap" >
                            <Run Text="Note: " FontWeight="Bold"/>
                            <Run Text="Choose" />
                            <Run Text="Credit Card or Line of Credit" FontWeight="Bold" />
                            <Run Text="to test which choice will save you the most time and money as your" />
                            <Run Text="Debt Destroyer" FontWeight="Bold" />
                            <Run Text="page." />
                                    </TextBlock>
                                </Grid>
                            </syncfusion:SfAccordionItem>
                        </syncfusion:SfAccordion>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="2" BorderBrush="DarkGray" Margin="4,4,4,8" CornerRadius="4" >
                        <ListView x:Name="lstIdentifyItems" SelectedIndex="0" SelectionChanged="lstIdentifyItems_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Name="ItemBorder" Background="#FFEDEDED" BorderBrush="#DDDDDD" 
                                        BorderThickness="1,1,1,1" Padding="8,2,8,2" Margin="0" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="128"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding _MNo, StringFormat='{}{0}.'}" 
                                                   FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" 
                                                   HorizontalAlignment="Left"/>

                                            <TextBlock Grid.Column="1" Text="{Binding _MSource}" 
                                                    FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" 
                                                    HorizontalAlignment="Left"/>

                                            <Border Grid.Column="2" Name="TypeBorder" CornerRadius="3" Width="42"
                                                    Padding="4,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding _MType}" VerticalAlignment="Center" 
                                                    HorizontalAlignment="Center" FontSize="16" 
                                                    FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding _MPayment, StringFormat='${0:F2}'}" 
                                                   FontWeight="SemiBold" VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right" FontSize="16" Name="ValueText"/>
                                        </Grid>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding _MType}" Value="CC">
                                            <Setter TargetName="TypeBorder" Property="Background" Value="DarkGreen"/>
                                            <Setter TargetName="TypeBorder" Property="BorderBrush" Value="DarkSlateGray"/>
                                            <Setter TargetName="TypeBorder" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding _MType}" Value="LOC">
                                            <Setter TargetName="TypeBorder" Property="Background" Value="DarkRed"/>
                                            <Setter TargetName="TypeBorder" Property="BorderBrush" Value="Maroon"/>
                                            <Setter TargetName="TypeBorder" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding _MType}" Value="OTHER">
                                            <Setter TargetName="TypeBorder" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="TypeBorder" Property="BorderBrush" Value="Transparent"/>
                                            <Setter TargetName="TypeBorder" Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="DarkMagenta"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DarkMagenta"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                        <Setter TargetName="Bd" Property="CornerRadius" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="2"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Border>
                </Grid>
                <Grid Margin="4" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <syncfusion:SfAccordion
                            Grid.Row="0"
                            x:Name="accordion2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            SelectedIndex="1"
                            SelectionMode="One">
                        <syncfusion:SfAccordion.HeaderTemplate>
                            <DataTemplate>
                                <Grid Background="DarkMagenta" Opacity="1" Margin="-14,0,-31,-4" Height="42">
                                    <TextBlock Foreground="white" TextWrapping="Wrap" Text="PAY DOWN DEBT DESTROYER" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" FontFamily="Arial Black" Margin="0,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </syncfusion:SfAccordion.HeaderTemplate>
                        <syncfusion:SfAccordionItem Header="WPF" FontSize="14" FontWeight="Bold">
                            <Grid HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock 
                                    Margin="4,4,4,4"
                                    HorizontalAlignment="Left"
                                    Foreground="Black"
                                    FontSize="14"
                                    TextWrapping="Wrap" >
                                    <Run Text="Dan and Jen: " FontWeight="Bold"/>
                                    <Run Text="Congratulations! You finished the tiresome part. Click implement and see how quickly you can be debt free." />
                                </TextBlock>
                            </Grid>
                        </syncfusion:SfAccordionItem>
                    </syncfusion:SfAccordion>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label
                            Grid.Column="0"
                            Content="Initial Balance:"
                            FontWeight="DemiBold" 
                            HorizontalContentAlignment="Right"
                            FontSize="18"
                            VerticalContentAlignment="Center"/>
                            <syncfusion:CurrencyTextBox
                             x:Name="ctbxInitialBalance"
                             Grid.Column="1"
                             TextAlignment="Center"
                             FontSize="18"
                                FontWeight="Bold"
                             Culture="en-US"
                             Value="0" VerticalAlignment="Stretch" Margin="0,6,32,6" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                Content="Available Income:"
                                FontWeight="DemiBold" 
                                HorizontalContentAlignment="Right"
                                FontSize="18"
                                VerticalContentAlignment="Center"/>
                            <syncfusion:CurrencyTextBox
                                 x:Name="ctbxAvailableIncome"
                                 Grid.Column="1"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 TextAlignment="Center"
                                 Culture="en-US"
                                 Value="0" VerticalAlignment="Stretch" Margin="0,6,32,6" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="0"
                                Content="Chargeable Expenses:"
                                FontWeight="DemiBold" 
                                HorizontalContentAlignment="Right"
                                FontSize="18"
                                VerticalContentAlignment="Center"/>
                            <syncfusion:CurrencyTextBox
                                 x:Name="ctbxChargeableExpenses"
                                 Grid.Column="1"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Margin="0,6,32,6" 
                                TextAlignment="Center"
                                Culture="en-US"
                                 Value="0" VerticalAlignment="Stretch" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label
                                 Grid.Column="0"
                                 Content="Interest Rate:"
                                 FontWeight="DemiBold" 
                                 HorizontalContentAlignment="Right"
                                 FontSize="18"
                                 VerticalContentAlignment="Center"/>
                            <syncfusion:PercentTextBox
                                 x:Name="ptbxInterestRate"
                                 Grid.Column="1"
                                FontWeight="Bold"
                                 FontSize="18"
                                 Margin="0,6,32,6" 
                                Culture="en-US"
                                TextAlignment="Center"
                                 PercentValue="0" VerticalAlignment="Stretch" />
                        </Grid>
                        <Grid Grid.Row="4">
                            <syncfusion:ButtonAdv 
                                 x:Name="btnCalculate"
                                 IconWidth="16" IconHeight="16"
                                 ToolTip="IMPLEMENT"
                                 VerticalAlignment="Center"
                                 Width="240" Height="32"
                                 SizeMode="Normal"
                                 Content="IMPLEMENT"
                                 Label="IMPLEMENT"
                                 FontSize="16"
                                 LargeIcon="/Assets/calculate.png" 
                                 SmallIcon="/Assets/calculate.png"
                                 HorizontalAlignment="Center" Margin="24,4,32,4"
                                 Cursor="Hand" Click="btnCalculate_Click" Background="DarkGreen" Foreground="White"/>
                        </Grid>
                        <Image Grid.Row="5" Source="/Views/App.png" Width="240" Stretch="UniformToFill"/>

                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="5" Source="/Views/AppBack.png" Stretch="Uniform"/>
                    <syncfusion:SfAccordion
                        Grid.Row="0"
                        x:Name="accordion3"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        SelectedIndex="1"
                        SelectionMode="One">
                        <syncfusion:SfAccordion.HeaderTemplate>
                            <DataTemplate>
                                <Grid Background="DarkMagenta" Opacity="1" Margin="-14,0,-31,-4" Height="42">
                                    <TextBlock Foreground="white" TextWrapping="Wrap" Text="SAVINGS RESULT" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" FontFamily="Arial Black" Margin="0,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </syncfusion:SfAccordion.HeaderTemplate>
                        <syncfusion:SfAccordionItem Header="WPF" FontSize="14" FontWeight="Bold" Width="632">
                            <Grid HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock 
                                        Margin="4,4,4,4"
                                        HorizontalAlignment="Left"
                                        Foreground="Black"
                                        FontSize="14"
                                        TextWrapping="Wrap" >
                                        <Run Text="Note: " FontWeight="Bold"/>
                                        <Run Text="Savings" />
                                </TextBlock>
                            </Grid>
                        </syncfusion:SfAccordionItem>
                    </syncfusion:SfAccordion>
                    <Border Grid.Row="1" BorderBrush="#CCA9A9A9" BorderThickness="2" Background="#FFEDEDED" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="4" Margin="0,8,0,8">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <Label
                                Grid.Column="0"
                                Content="Traditional"
                                FontWeight="DemiBold" 
                                HorizontalContentAlignment="Center"
                                FontSize="18"
                                Foreground="DarkRed"
                                VerticalContentAlignment="Center"/>
                                <Label
                                Grid.Column="1"
                                Content="Pay Down"
                                FontWeight="DemiBold" 
                                HorizontalContentAlignment="Center"
                                FontSize="18"
                                Foreground="DarkRed"
                                VerticalContentAlignment="Center"/>
                                <Label
                                Grid.Column="2"
                                Content="Savings"
                                FontWeight="DemiBold"
                                Foreground="DarkGreen"
                                HorizontalContentAlignment="Center"
                                FontSize="18"
                                VerticalContentAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <Label
                                    x:Name="lblTradMonths"
                                    Grid.Column="0"
                                    Content="12 Months"
                                    FontWeight="DemiBold" 
                                    HorizontalContentAlignment="Center"
                                    FontSize="18"
                                    VerticalContentAlignment="Center"/>
                                <Label
                                    x:Name="lblPayDownMonths"
                                    Grid.Column="1"
                                    Content="8 Months"
                                    FontWeight="DemiBold" 
                                    HorizontalContentAlignment="Center"
                                    FontSize="18"
                                    VerticalContentAlignment="Center"/>
                                <Label
                                    x:Name="lblSavingMonths"
                                    Grid.Column="2"
                                    Content="4 Months"
                                    FontWeight="DemiBold" 
                                    HorizontalContentAlignment="Center"
                                    FontSize="18"
                                    VerticalContentAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <syncfusion:CurrencyTextBox
                                 x:Name="ctbxSTraditional"
                                 Grid.Column="0"
                                 FontSize="18"
                                 Margin="24,0,24,4" 
                                 TextAlignment="Center"
                                 FontWeight="Bold"
                                 IsReadOnly="True"
                                 Culture="en-US"
                                 Value="0" VerticalAlignment="Stretch" />
                                <syncfusion:CurrencyTextBox
                                 x:Name="ctbxSPayDown"
                                 Grid.Column="1"
                                 FontSize="18"
                                 Margin="24,0,24,4" 
                                 FontWeight="Bold"
                                 TextAlignment="Center"
                                 IsReadOnly="True"
                                 Culture="en-US"
                                 Value="0" VerticalAlignment="Stretch" />
                                <syncfusion:CurrencyTextBox
                                 x:Name="ctbxSSavings"
                                 Grid.Column="2"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Margin="24,0,24,4" 
                                 TextAlignment="Center"
                                 IsReadOnly="True"
                                 Culture="en-US"
                                 Value="0" VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <busy:SfBusyIndicator
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    IsBusy="False"
                    Foreground="DarkMagenta"
                    x:Name="busyIndicator"
                    AnimationType="Box">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="tbxTitle" FontSize="16" FontWeight="Bold" Text="Result" Background="DarkMagenta" TextAlignment="Center" Margin="0,0,0,0" Foreground="White" />
                    <Grid Grid.Row="1">
                        <syncfusion:SfDataGrid
                               x:Name="sfdatagrid"
                               AllowEditing="False"
                               RowHeight="32"
                               EnableDataVirtualization="True"
                               ColumnSizer="Star"
                               HeaderRowHeight="48"
                               ScrollMode="None"
                               AutoGenerateColumns="False"
                               GridLinesVisibility="Horizontal"
                               AllowSorting="False"
                               FontSize="16"
                               SelectionMode="Single"
                               SelectionUnit="Cell">
                            <syncfusion:SfDataGrid.Resources>
                                <Style TargetType="syncfusion:GridHeaderCellControl">
                                    <Setter Property="Background" Value="DarkMagenta"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </syncfusion:SfDataGrid.Resources>
                            <syncfusion:SfDataGrid.Columns>
                                <syncfusion:GridTextColumn HeaderText="Months to Payoff" MappingName="MMonthsToPayoff" AllowEditing="False" TextAlignment="Center" Width="80">
                                    <syncfusion:GridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Months to Payoff" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.HeaderTemplate>
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MMonthsToPayoff}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>
                                <syncfusion:GridTextColumn
                                    HeaderText="Balance"
                                    AllowEditing="False"
                                    TextAlignment="Center"
                                    MappingName="MMonthlyBalance">
                                    <syncfusion:GridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Monthly Starting Balance" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.HeaderTemplate>
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MMonthlyBalance, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>
                                <syncfusion:GridTextColumn
                                    HeaderText="Available Income"
                                    AllowEditing="False"
                                    TextAlignment="Center"
                                    MappingName="MMonthlyBalance">
                                    <syncfusion:GridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Available Income" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.HeaderTemplate>
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MAvailableIncome, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>
                                <syncfusion:GridTextColumn
                                    HeaderText="New Balance"
                                    AllowEditing="False"
                                    TextAlignment="Center"
                                    MappingName="MMonthlyBalance">
                                    <syncfusion:GridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="New Balance" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.HeaderTemplate>
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MNewBalance, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>

                                <syncfusion:GridTextColumn
                                    HeaderText="Chargeable Expenses"
                                    AllowEditing="False"
                                    TextAlignment="Center"
                                    MappingName="MChargeableExpenses">
                                    <syncfusion:GridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Chargeable Expenses" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.HeaderTemplate>
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MChargeableExpenses, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>

                                <syncfusion:GridTextColumn
                                    HeaderText="Interest"
                                    AllowEditing="False"
                                    TextAlignment="Center"
                                    MappingName="MChargeableExpenses">
                                    <syncfusion:GridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Interest" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.HeaderTemplate>
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MInterest, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>
                                <syncfusion:GridTextColumn
                                    HeaderText="Monthly Ending Balance"
                                    AllowEditing="False"
                                    TextAlignment="Center"
                                    MappingName="MChargeableExpenses">
                                    <syncfusion:GridTextColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="Monthly Ending Balance" TextWrapping="Wrap" TextAlignment="Center" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.HeaderTemplate>
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MMonthlyEndBalance, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>
                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </Grid>
                </Grid>
            </busy:SfBusyIndicator>
        </Grid>
    </Grid>
</UserControl>
