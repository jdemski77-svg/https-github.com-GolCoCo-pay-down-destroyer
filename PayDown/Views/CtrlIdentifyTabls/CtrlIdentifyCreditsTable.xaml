<UserControl xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             x:Class="PayDown.CtrlIdentifyCreditsTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PayDown"
             xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             skinManager:SfSkinManager.Theme="{skinManager:SkinManagerExtension ThemeName=Material3Light}"
             Loaded="UserControl_Loaded"
             d:Width="350"
             d:Height="500"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <syncfusion:SfAccordion
                    x:Name="accordion"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="4,4,4,4"
                    Cursor="Hand"
                    SelectedIndex="1"
                    SelectionMode="One">
                <syncfusion:SfAccordion.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Margin="32,4,0,4"  TextWrapping="Wrap" Text="Credit Cards &amp; Revolving Lines of Credit" TextAlignment="Left" FontSize="18" FontWeight="Bold" FontFamily="Arial Black" />
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfAccordion.HeaderTemplate>
                <syncfusion:SfAccordionItem Header="WPF" FontSize="14" FontWeight="Bold">
                    <Grid HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Margin="4,4,4,4"
                            HorizontalAlignment="Left"
                            Foreground="Black"
                            FontSize="14"
                            TextWrapping="Wrap" >
                            <Run Text="Dan:" FontWeight="Bold"/>
                            <Run Text="There can be only one. Mark an 'X' for the " />
                            <Run Text="Debt Destroyer " FontWeight="Bold"/>
                            <Run Text="of your choice. Your choice will automatically be entered into the" />
                            <Run Text="Debt Destroyer" FontWeight="Bold"/>
                            <Run Text="on the" />
                            <Run Text="Implement" FontWeight="Bold" />
                            <Run Text="page." />
                        </TextBlock>
                    </Grid>
                </syncfusion:SfAccordionItem>
            </syncfusion:SfAccordion>
        </Grid>
        <Grid Grid.Row="1" Margin="4,0,4,4">
            <syncfusion:SfDataGrid
                x:Name="sfdatagrid"
                Margin="0"
                AllowEditing="True"
                GridLinesVisibility="Horizontal"
                AllowGrouping="True"
                AutoGenerateColumns="False"
                ColumnSizer="Star"
                FontSize="18"
                HeaderRowHeight="32"
                EditTrigger ="OnTap"
                AllowSorting="False"
                RowHeight="28"
                SelectionMode="Single"
                CurrentCellActivated="sfdatagrid_CurrentCellActivated"
                SelectionUnit="Cell">
                <syncfusion:SfDataGrid.Resources>
                    <Style TargetType="syncfusion:GridHeaderCellControl">
                        <Setter Property="Background" Value="DarkGoldenrod"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </syncfusion:SfDataGrid.Resources>
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="" MappingName="MNo1" Width="32" AllowEditing="False" TextAlignment="Center">
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="Black" FontSize="16"
                                        Text="{Binding MNo1}" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource1" Width="320" AllowEditing="False">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource1}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                                    TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                                    Text="{Binding MSource1}"
                                    Padding="24,0,12,0"
                                    syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                    <syncfusion:GridTextColumn
						        HeaderText="Payment"
						        AllowEditing="False"
						        TextAlignment="Center"
						        MappingName="MPayment1">
                        <syncfusion:GridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Payment" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.HeaderTemplate>
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MPayment1, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn
						        HeaderText="Balance"
						        AllowEditing="False"
						        TextAlignment="Center"
						        MappingName="MBalance1">
                        <syncfusion:GridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Balance" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.HeaderTemplate>
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MBalance1, StringFormat={}{0:C0}}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn
						        HeaderText="Interest Rate"
						        AllowEditing="False"
						        TextAlignment="Center"
						        MappingName="MInterestRate1">
                        <syncfusion:GridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Interest Rate" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.HeaderTemplate>
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MInterestRate1, StringFormat={}{0}%}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Black" FontSize="18" Margin="4,4,4,4" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="Debt Destroyer" IsReadOnly="True" MappingName="MMark1"  AllowEditing="False" TextAlignment="Center">
                        <syncfusion:GridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Debt Destroyer" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.HeaderTemplate>
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Black" FontSize="16"
                                    FontWeight="Bold"
                                    Text="{Binding MMark1}" />
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Grid>
    </Grid>
</UserControl>
