<syncfusion:ChromelessWindow x:Class="PayDown.Views.WinLogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:listCollection="clr-namespace:System.Collections;assembly=mscorlib"
    xmlns:local="clr-namespace:PayDown"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Title="{Binding AppTitle}"
    Width="653"
    Height="295"

    BorderThickness="0"
    AllowsTransparency="True"
    CloseButtonTemplate="{DynamicResource ProductsWindowCloseButtonTemplate}"
    ResizeBorderThickness="0"
    RestoreButtonTemplate="{DynamicResource ProductsWindowRestoreButtonTemplate}"
    ShowIcon="False"
    Icon="/Assets/App.ico"
    TitleBarBackground="{Binding TitleBarBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    TitleBarForeground="{Binding TitleBarForeground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    TitleBarHeight="40"
    TitleTextAlignment="Center"
    TitleFontSize="14"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    xmlns:busy="clr-namespace:Syncfusion.Windows.Controls.Notification;assembly=Syncfusion.SfBusyIndicator.WPF"   
    Loaded="ChromelessWindow_Loaded"
    ResizeMode="NoResize"
    mc:Ignorable="d" ShowMaximizeButton="False" ShowMinimizeButton="False" FontFamily="Copperplate Gothic Light">
    <syncfusion:ChromelessWindow.DataContext>
        <local:LoginModel/>
    </syncfusion:ChromelessWindow.DataContext>
    <syncfusion:ChromelessWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <syncfusion:ChromelessWindow.LeftHeaderItemsSource>
        <listCollection:ArrayList>
            <Image
                Width="24"
                Height="24"
                Margin="12,0,3,0"
                Source="/Views/App.png" />
        </listCollection:ArrayList>
    </syncfusion:ChromelessWindow.LeftHeaderItemsSource>
    <busy:SfBusyIndicator
     Grid.Row="2"
     x:Name="busyIndicator"
     IsBusy="False"
     AnimationType="Box">
        <Grid>
            <Image HorizontalAlignment="Left" Height="240" Margin="3,3,0,0" VerticalAlignment="Top" Width="240" Source="/Views/App.png" Stretch="Fill"/>
            <TextBox x:Name="tbxUserName" FontSize="14" VerticalContentAlignment="Bottom" VerticalAlignment="Top" Height="22" Margin="333,58,34,0" TextChanged="tbxUserName_TextChanged"/>
            <Label Content="Username:" HorizontalAlignment="Left"  Margin="245,59,0,0" VerticalAlignment="Top" Height="25" Width="83" HorizontalContentAlignment="Right" FontFamily="Copperplate Gothic Light"/>
            <PasswordBox x:Name="psbPassword" FontSize="14"  VerticalAlignment="Top" VerticalContentAlignment="Bottom" Height="22" Margin="333,95,34,0" PasswordChanged="psbPassword_PasswordChanged"/>
            <Label Content="Password:" HorizontalAlignment="Left" Margin="245,96,0,0" VerticalAlignment="Top" Height="22" Width="83" HorizontalContentAlignment="Right" FontFamily="Copperplate Gothic Light"/>
            <CheckBox x:Name="cbxRemember" Content="REMEMBER ME" VerticalAlignment="Top" FontFamily="Copperplate Gothic Light" Margin="333,138,185,0" Checked="cbxRemember_Checked" Unchecked="cbxRemember_Unchecked"/>
            <Button x:Name="btnLogin" Content="Login" VerticalAlignment="Top" Background="#FF2B579A" Foreground="White" Height="30" FontSize="14" FontFamily="Copperplate Gothic Light" Click="btnLogin_Click" Cursor="Hand" Margin="349,171,43,0"/>
        </Grid>
    </busy:SfBusyIndicator>
</syncfusion:ChromelessWindow>
