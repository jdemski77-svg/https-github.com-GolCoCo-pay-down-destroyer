<UserControl xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             x:Class="PayDown.CtrlDebtsLivingExpTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PayDown"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             skinManager:SfSkinManager.Theme="{skinManager:SkinManagerExtension ThemeName=Material3Light}"
             Loaded="UserControl_Loaded"
             d:Width="350"
             d:Height="500"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <Grid>
            <syncfusion:SfAccordion
                    x:Name="accordion"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="4,4,4,4"
                    Cursor="Hand"
                    SelectedIndex="1"
                    SelectionMode="One">
                <syncfusion:SfAccordion.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Margin="32,4,0,4"  TextWrapping="Wrap" Text="Living Expenses" TextAlignment="Left" FontSize="18" FontWeight="Bold" FontFamily="Arial Black" />
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfAccordion.HeaderTemplate>
                <syncfusion:SfAccordionItem Header="WPF" FontSize="14" FontWeight="Bold">
                    <Grid HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                                            Margin="4,4,4,4"
                                            HorizontalAlignment="Left"
                                            Foreground="Black"
                                            FontSize="14"
                                            TextWrapping="Wrap" >
                            <Run Text="Dan: " FontWeight="Bold"/>
                            <Run Text="This section is for your monthly expenses that vary each month. Gas, Groceries, Movies, Dinners, Lunches, Coffees, Space Tourism, Bar Tab, Hot Yoga, Massages, Axe Throwing, Riding Lessons, Prescriptions, Kid's Sports/Activities, etc. Take at least a 3 month average of these expenses - 6 months would be better." />
                            <Run Text="Look at your debit &amp; credit card transactions online banking, or your monthly mailed statements."/>
                        </TextBlock>
                    </Grid>
                </syncfusion:SfAccordionItem>
            </syncfusion:SfAccordion>
        </Grid>
        <Grid Grid.Row="1" Margin="4,0,4,4">
            <syncfusion:SfDataGrid
                x:Name="sfdatagrid"
                Margin="0"
                AllowEditing="True"
                GridLinesVisibility="Horizontal"
                AllowGrouping="True"
                AutoGenerateColumns="False"
                ColumnSizer="Star"
                FontSize="18"
                EditTrigger ="OnTap"
                AllowSorting="False"
                RowHeight="32"
                SelectionMode="Single"
                CurrentCellEndEdit="sfdatagrid_CurrentCellEndEdit"
                SelectionUnit="Cell">
                <syncfusion:SfDataGrid.Resources>
                    <Style TargetType="syncfusion:GridHeaderCellControl">
                        <Setter Property="Background" Value="DarkRed"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </syncfusion:SfDataGrid.Resources>
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="" MappingName="MNo1" Width="32" AllowEditing="False" TextAlignment="Center">
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MNo1}" TextWrapping="Wrap" Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridComboBoxColumn HeaderText="Chargeable" MappingName="MCYN1"  Width="120">
                        <syncfusion:GridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>YES</sys:String>
                                <sys:String>NO</sys:String>
                            </x:Array>
                        </syncfusion:GridComboBoxColumn.ItemsSource>
                        <syncfusion:GridComboBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Chargeable (Y/N)" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.HeaderTemplate>
                        <syncfusion:GridComboBoxColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MCYN1}" TextWrapping="Wrap" Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.CellTemplate>
                    </syncfusion:GridComboBoxColumn>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource1" Width="200">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource1}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                                    TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                                    Text="{Binding MSource1}"
                                    Padding="24,0,12,0"
                                    syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                    <syncfusion:GridCurrencyColumn
                                    CurrencyDecimalDigits="0"
                                    HeaderText="Amount"
                                    MappingName="MAmount1">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MAmount1}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridTextColumn HeaderText="" MappingName="MNo1" Width="32" AllowEditing="False" TextAlignment="Center">
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"  Background="Gray" Width="1" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MNo2}" TextWrapping="Wrap"  Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridComboBoxColumn HeaderText="Chargeable" MappingName="MCYN2"  Width="120">
                        <syncfusion:GridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>YES</sys:String>
                                <sys:String>NO</sys:String>
                            </x:Array>
                        </syncfusion:GridComboBoxColumn.ItemsSource>
                        <syncfusion:GridComboBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Chargeable (Y/N)" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.HeaderTemplate>
                        <syncfusion:GridComboBoxColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MCYN2}" TextWrapping="Wrap" Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.CellTemplate>
                    </syncfusion:GridComboBoxColumn>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource2" Width="200">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource2}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                                        TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                                        Text="{Binding MSource2}"
                                        Padding="24,0,12,0"
                                        syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                    <syncfusion:GridCurrencyColumn
                            CurrencyDecimalDigits="0"
                            HeaderText="Amount"
                            MappingName="MAmount2">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MAmount2}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridTextColumn HeaderText="" MappingName="MNo1" Width="32" AllowEditing="False" TextAlignment="Center">
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"  Background="Gray" Width="1" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MNo3}" TextWrapping="Wrap"  Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridComboBoxColumn HeaderText="Chargeable" MappingName="MCYN3"  Width="120">
                        <syncfusion:GridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>YES</sys:String>
                                <sys:String>NO</sys:String>
                            </x:Array>
                        </syncfusion:GridComboBoxColumn.ItemsSource>
                        <syncfusion:GridComboBoxColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MCYN3}" TextWrapping="Wrap" Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.CellTemplate>
                        <syncfusion:GridComboBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Chargeable (Y/N)" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.HeaderTemplate>
                    </syncfusion:GridComboBoxColumn>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource3" Width="200">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource3}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                                    TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                                    Text="{Binding MSource3}"
                                    Padding="24,0,12,0"
                                    syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                    <syncfusion:GridCurrencyColumn
                                CurrencyDecimalDigits="0"
                                HeaderText="Amount"
                                MappingName="MAmount3">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MAmount3}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Grid>
        <Grid Grid.Row="2" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" Text="Subtotal" TextAlignment="Right" Margin="0,4,4,0"/>
            <syncfusion:CurrencyTextBox
                    x:Name="ctbxSubTotal"
                    Grid.Column="2"
                    FontSize="16"
                    FontWeight="Bold"
                    IsReadOnly="True"
                    CurrencyPositivePattern="2"
                Culture="en-US"
                    Value="0" />
        </Grid>
    </Grid>
</UserControl>
