<UserControl xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             x:Class="PayDown.CtrlDebtsCreditsTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PayDown"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
             skinManager:SfSkinManager.Theme="{skinManager:SkinManagerExtension ThemeName=Material3Light}"
             Loaded="UserControl_Loaded"
             d:Width="350"
             d:Height="500"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <Grid>
            <syncfusion:SfAccordion
                    x:Name="accordion"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="4,4,4,4"
                    Cursor="Hand"
                    SelectedIndex="1"
                    SelectionMode="One">
                <syncfusion:SfAccordion.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Margin="32,4,0,4"  TextWrapping="Wrap" Text="Credit Cards and Revolving Lines of Credit" TextAlignment="Left" FontSize="18" FontWeight="Bold" FontFamily="Arial Black" />
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfAccordion.HeaderTemplate>
                <syncfusion:SfAccordionItem Header="WPF" FontSize="14" FontWeight="Bold">
                    <Grid HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                                                Margin="4,4,4,4"
                                                HorizontalAlignment="Left"
                                                Foreground="Black"
                                                FontSize="14"
                                                TextWrapping="Wrap" >
                            <Run x:Name="tbxRunName" FontWeight="Bold"/>
                            <Run x:Name="tbxRunContent" /><LineBreak/><LineBreak/>
                            <Run Text="Note: " FontWeight="Bold"/>
                            <Run Text="Be sure to select Credit Card (CC), or Line of Credit (LOC) for each entry." />
                        </TextBlock>
                    </Grid>
                </syncfusion:SfAccordionItem>
            </syncfusion:SfAccordion>
        </Grid>
        <Grid Grid.Row="1" Margin="4,0,4,4">
            <syncfusion:SfDataGrid
                x:Name="sfdatagrid"
                Margin="0"
                AllowEditing="True"
                GridLinesVisibility="Horizontal"
                AllowGrouping="True"
                AutoGenerateColumns="False"
                ColumnSizer="Star"
                FontSize="18"
                AllowSorting="False"
                EditTrigger ="OnTap"
                RowHeight="32"
                SelectionMode="Single"
                CurrentCellEndEdit="sfdatagrid_CurrentCellEndEdit"
                SelectionUnit="Cell">
                <syncfusion:SfDataGrid.Resources>
                    <Style TargetType="syncfusion:GridHeaderCellControl">
                        <Setter Property="Background" Value="DarkRed"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </syncfusion:SfDataGrid.Resources>
                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="" MappingName="MNo1" Width="32" AllowEditing="False" TextAlignment="Center">
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MNo1}" TextWrapping="Wrap" Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource1" Width="200">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource1}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                                    TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                                    Text="{Binding MSource1}"
                                    Padding="24,0,12,0"
                                    syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                    <syncfusion:GridComboBoxColumn HeaderText="TYPE (CC/LOC)" MappingName="MCType1"  Width="120">
                        <syncfusion:GridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>CC</sys:String>
                                <sys:String>LOC</sys:String>
                            </x:Array>
                        </syncfusion:GridComboBoxColumn.ItemsSource>
                        <syncfusion:GridComboBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="TYPE (CC/LOC)" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.HeaderTemplate>
                        <syncfusion:GridComboBoxColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MCType1}" TextWrapping="Wrap" Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.CellTemplate>
                    </syncfusion:GridComboBoxColumn>
                    <syncfusion:GridCurrencyColumn
                                CurrencyDecimalDigits="0"
                                HeaderText="Payment"
                                MappingName="MPayment1">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MPayment1}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridCurrencyColumn
                                CurrencyDecimalDigits="0"
                                HeaderText="Balance"
                                MappingName="MBalance1">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MBalance1}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridCurrencyColumn
                         CurrencyDecimalDigits="0"
                         HeaderText="Limit"
                         MappingName="MLimit1">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MLimit1}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridPercentColumn HeaderText="Interest Rate" MappingName="MInterestRate1">
                        <syncfusion:GridPercentColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    x:Name="text"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Black" FontSize="18"
                                    Text="{Binding MInterestRate1, StringFormat={}{0}%}" />
                            </DataTemplate>
                        </syncfusion:GridPercentColumn.CellTemplate>
                    </syncfusion:GridPercentColumn>


                    <syncfusion:GridTextColumn HeaderText="" MappingName="MNo1" Width="32" AllowEditing="False" TextAlignment="Center">
                        <syncfusion:GridTextColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"  Background="Gray" Width="1" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MNo2}" TextWrapping="Wrap"  Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:GridTextColumn.CellTemplate>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTemplateColumn HeaderText="Source" MappingName="MSource2" Width="200">
                        <syncfusion:GridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MSource2}" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Left" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.CellTemplate>
                        <syncfusion:GridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <TextBox
                                    TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"
                                    Text="{Binding MSource2}"
                                    Padding="24,0,12,0"
                                    syncfusion:FocusManagerHelper.FocusedElement="True" />
                            </DataTemplate>
                        </syncfusion:GridTemplateColumn.EditTemplate>
                    </syncfusion:GridTemplateColumn>
                    <syncfusion:GridComboBoxColumn HeaderText="TYPE (CC/LOC)" MappingName="MCType2"  Width="120">
                        <syncfusion:GridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}">
                                <sys:String>CC</sys:String>
                                <sys:String>LOC</sys:String>
                            </x:Array>
                        </syncfusion:GridComboBoxColumn.ItemsSource>
                        <syncfusion:GridComboBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="TYPE (CC/LOC)" TextWrapping="Wrap" TextAlignment="Center" />
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.HeaderTemplate>
                        <syncfusion:GridComboBoxColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MCType2}" TextWrapping="Wrap" Foreground="Black" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Padding="4,0,4,0"/>
                            </DataTemplate>
                        </syncfusion:GridComboBoxColumn.CellTemplate>
                    </syncfusion:GridComboBoxColumn>
                    <syncfusion:GridCurrencyColumn
                                CurrencyDecimalDigits="0"
                                HeaderText="Payment"
                                MappingName="MPayment2">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MPayment2}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridCurrencyColumn
                                CurrencyDecimalDigits="0"
                                HeaderText="Balance"
                                MappingName="MBalance2">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MBalance2}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridCurrencyColumn
                             CurrencyDecimalDigits="0"
                             HeaderText="Limit"
                             MappingName="MLimit2">
                        <syncfusion:GridCurrencyColumn.CellTemplate>
                            <DataTemplate>
                                <syncfusion:CurrencyTextBox Value ="{Binding MLimit2}" Culture="en-US" BorderThickness="0" Padding="4,0,4,0" TextWrapping="Wrap" Foreground="Black" FontSize="18" TextAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </syncfusion:GridCurrencyColumn.CellTemplate>
                    </syncfusion:GridCurrencyColumn>
                    <syncfusion:GridPercentColumn HeaderText="Interest Rate" MappingName="MInterestRate2">
                        <syncfusion:GridPercentColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    x:Name="text"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Black" FontSize="18"
                                    Text="{Binding MInterestRate2, StringFormat={}{0}%}" />
                            </DataTemplate>
                        </syncfusion:GridPercentColumn.CellTemplate>
                    </syncfusion:GridPercentColumn>
                    

                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>
        </Grid>
        <Grid Grid.Row="2" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" Text="Subtotal Payments" TextAlignment="Center" Margin="0,4,4,0"/>
            <syncfusion:CurrencyTextBox
                    x:Name="ctbxSubTotalPayment"
                    Grid.Column="2"
                    FontSize="16"
                    FontWeight="Bold"
                    IsReadOnly="True"
                Culture="en-US"
                    CurrencyPositivePattern="2"
                    Value="0" />

            <TextBlock Grid.Column="4" FontSize="16" FontWeight="Bold" Text="Subtotal Balances" TextAlignment="Right" Margin="0,4,4,0"/>
            <syncfusion:CurrencyTextBox
                    x:Name="ctbxSubTotalBalance"
                    Grid.Column="5"
                    FontSize="16"
                    FontWeight="Bold"
                    IsReadOnly="True"
                Culture="en-US"
                    CurrencyPositivePattern="2"
                    Margin="4,0,0,0"
                    Value="0" />
        </Grid>
    </Grid>
</UserControl>
