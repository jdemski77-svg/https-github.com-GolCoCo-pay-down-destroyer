<syncfusion:ChromelessWindow x:Class="PayDown.SubViews.WinSavingBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PayDown.SubViews"
        xmlns:skinManager="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        skinManager:SfSkinManager.Theme="{skinManager:SkinManagerExtension ThemeName=Material3Light}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        mc:Ignorable="d"
        Icon="/Assets/App.ico"
        ShowMaximizeButton="False" ShowMinimizeButton="False"
        WindowStartupLocation="CenterScreen"
        BorderThickness="0"
        AllowsTransparency="True"
        ResizeBorderThickness="0"
        TitleBarHeight="0"
        ResizeMode="NoResize"
        WindowStyle="None"
        Title="" Height="42" Width="504">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"></RowDefinition>
            <RowDefinition Height="10"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Saving now. Please wait..." TextAlignment="Center" FontSize="14" Margin="0,8,0,4"></TextBlock>
        <syncfusion:SfLinearProgressBar x:Name="prgStatus" Grid.Row="1" IsIndeterminate="True" />
    </Grid>
</syncfusion:ChromelessWindow>
