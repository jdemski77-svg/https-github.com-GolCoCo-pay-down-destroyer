{
  "name": "Pay Down",
  "description": "Members-only debt Pay Down planner. Visitors pay, create an account, then use the tool.",
  // Public so visitors can reach the Join page and pay before they have an account.
  // The tool itself and all saved data are locked to paid members (see entities/*.jsonc).
  "visibility": "public",
  "site": {
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "serveCommand": "npm run dev",
    "outputDirectory": "./out"
  }
}
