{
  "name": "Pay Down",
  "description": "Members area for The Pay Down Blueprint clients.",
  // Public so clients can reach the sign-up page before they have an account.
  // Saved data is locked to each member, and to non-revoked members (see entities/*.jsonc).
  "visibility": "public",
  "site": {
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "serveCommand": "npm run dev",
    "outputDirectory": "./out"
  }
}
