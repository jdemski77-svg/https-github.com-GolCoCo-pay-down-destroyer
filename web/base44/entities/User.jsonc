// Custom fields on the built-in User entity.
// Both fields are write-locked: members can't change them from the app (not even
// with updateMe). Only the backend functions and the app's editors in the Base44
// dashboard can. PayDownPlan's access rules trust membership_status.
{
  "name": "User",
  "type": "object",
  "properties": {
    "membership_status": {
      "type": "string",
      "enum": ["none", "active", "inactive", "revoked"],
      "description": "Copied from MemberAccess for this user's email. active = can use the tool.",
      "rls": { "update": { "user_condition": { "collaborator_role": "editor" } } }
    },
    "membership_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the server re-checked this member's access.",
      "rls": { "update": { "user_condition": { "collaborator_role": "editor" } } }
    }
  }
}
